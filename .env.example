# Copy to .env and fill in. Used only for the OPTIONAL live-load path
# (graphdb.py) and the OPTIONAL embeddings path. The default pipeline emits
# portable artifacts and needs none of this.

# --- Neo4j AuraDB (HTTP Query API, not Bolt — Bolt/7687 is blocked by
# HTTPS-only egress proxies). Format:
#   https://<dbid>.databases.neo4j.io/db/neo4j/query/v2
NEO4J_QUERY_URL=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Embeddings (optional). Multilingual model recommended for Chinese.
# Default falls back to no-op embeddings if sentence-transformers / weights
# are unavailable.
EMBEDDING_MODEL=BAAI/bge-m3
