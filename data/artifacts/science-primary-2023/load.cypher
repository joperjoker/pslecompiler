MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-the-integration-of-the-different-systems-digestive-respir:9f744cd8e4'}) SET x += {uid: 'learningoutcome:science-2023-recognise-the-integration-of-the-different-systems-digestive-respir:9f744cd8e4', text: 'Recognise the integration of the different systems (digestive, respiratory and circulatory) in carrying out life processes.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.56', order: 30};
MERGE (x:Topic {uid: 'topic:science-2023-human-system-respiratory-and-circulatory-systems-p5-foundation:3506b223dc'}) SET x += {uid: 'topic:science-2023-human-system-respiratory-and-circulatory-systems-p5-foundation:3506b223dc', name: 'Human System (Respiratory and circulatory systems) (P5 Foundation)', subject: 'Science', syllabus_version: '2023', primary_level: 'P5', track: 'Foundation', core_ideas: ['Compare how plants and humans take in', 'oxygen and give out carbon dioxide.', 'Note:', 'The use of specific terms (xylem, phloem', 'and stomata, artery, vein, capillary) is not', 'required.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-identify-the-parts-of-the-human-respiratory-nose-windpipe-lungs-and:8ce93b3bb9'}) SET x += {uid: 'learningoutcome:science-2023-identify-the-parts-of-the-human-respiratory-nose-windpipe-lungs-and:8ce93b3bb9', text: 'Identify the parts of the human respiratory (nose, windpipe, lungs) and circulatory systems (heart, blood, blood vessels) and state their functions.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.56', order: 32};
MERGE (x:Topic {uid: 'topic:science-2023-plant-system-plant-parts-and-functions-p4:e9669339d5'}) SET x += {uid: 'topic:science-2023-plant-system-plant-parts-and-functions-p4:e9669339d5', name: 'Plant System (Plant parts and functions) (P4)', subject: 'Science', syllabus_version: '2023', primary_level: 'P4', track: null, core_ideas: ['Observe plant parts.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-identify-the-different-parts-of-plants-and-state-their-functions-le:3f0776a7ab'}) SET x += {uid: 'learningoutcome:science-2023-identify-the-different-parts-of-plants-and-state-their-functions-le:3f0776a7ab', text: 'Identify the different parts of plants and state their functions. - Leaf - Stem - Root', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P4', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.57', order: 33};
MERGE (x:Topic {uid: 'topic:science-2023-plant-system-respiratory-and-circulatory-systems-p5-standard:bb4aa1350c'}) SET x += {uid: 'topic:science-2023-plant-system-respiratory-and-circulatory-systems-p5-standard:bb4aa1350c', name: 'Plant System (Respiratory and circulatory systems) (P5 Standard)', subject: 'Science', syllabus_version: '2023', primary_level: 'P5', track: 'Standard', core_ideas: ['Investigate how food and water are', 'transported in the plant.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-identify-the-parts-of-the-plant-transport-system-and-describe-their:7e51a02f23'}) SET x += {uid: 'learningoutcome:science-2023-identify-the-parts-of-the-plant-transport-system-and-describe-their:7e51a02f23', text: 'Identify the parts of the plant transport system and describe their functions.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.58', order: 34};
MERGE (x:Topic {uid: 'topic:science-2023-plant-system-respiratory-and-circulatory-systems-p5-foundation:97b5f75379'}) SET x += {uid: 'topic:science-2023-plant-system-respiratory-and-circulatory-systems-p5-foundation:97b5f75379', name: 'Plant System (Respiratory and circulatory systems) (P5 Foundation)', subject: 'Science', syllabus_version: '2023', primary_level: 'P5', track: 'Foundation', core_ideas: ['Observe how food and water are', 'transported in the plant.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-how-water-is-transported-from-the-roots-to-other-parts-of:8961d8f786'}) SET x += {uid: 'learningoutcome:science-2023-recognise-how-water-is-transported-from-the-roots-to-other-parts-of:8961d8f786', text: 'Recognise how water is transported from the roots to other parts of the plant and how food is transported from the leaves to other parts of the plant.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.59', order: 35};
MERGE (x:Topic {uid: 'topic:science-2023-electrical-system-p5-standard:fae7d6bd90'}) SET x += {uid: 'topic:science-2023-electrical-system-p5-standard:fae7d6bd90', name: 'Electrical System (P5 Standard)', subject: 'Science', syllabus_version: '2023', primary_level: 'P5', track: 'Standard', core_ideas: ['Construct simple circuits from circuit', 'diagrams.', 'Investigate the effect of some variables on', 'the current in a circuit.', 'Number of batteries (arranged in', 'series)', 'Number of bulbs (arranged in series', 'and parallel)']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-that-an-electric-circuit-consisting-of-an-energy-source-b:7e950ea487'}) SET x += {uid: 'learningoutcome:science-2023-recognise-that-an-electric-circuit-consisting-of-an-energy-source-b:7e950ea487', text: 'Recognise that an electric circuit consisting of an energy source (battery) and other circuit components (wire, bulb, switch) forms an electrical system.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.61', order: 39, cognitive_level: 'application', difficulty_band: 'core'};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-show-an-understanding-that-a-closed-circuit-allows-current-to-flow:8c0d8909ca'}) SET x += {uid: 'learningoutcome:science-2023-show-an-understanding-that-a-closed-circuit-allows-current-to-flow:8c0d8909ca', text: 'Show an understanding that a closed circuit allows current to flow.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.60', order: 37};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-identify-electrical-conductors-and-insulators:4affe23a39'}) SET x += {uid: 'learningoutcome:science-2023-identify-electrical-conductors-and-insulators:4affe23a39', text: 'Identify electrical conductors and insulators.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.62', order: 41, cognitive_level: 'knowledge', difficulty_band: 'core'};
MERGE (x:Topic {uid: 'topic:science-2023-electrical-system-p5-foundation:7a515b2855'}) SET x += {uid: 'topic:science-2023-electrical-system-p5-foundation:7a515b2855', name: 'Electrical System (P5 Foundation)', subject: 'Science', syllabus_version: '2023', primary_level: 'P5', track: 'Foundation', core_ideas: ['Construct simple circuits from circuit', 'diagrams.', 'Investigate the effect of some variables on', 'the current in a circuit.', 'Number of batteries (arranged in series)', 'Number of bulbs (arranged in series)']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-state-that-a-closed-circuit-allows-current-to-flow:6bac303209'}) SET x += {uid: 'learningoutcome:science-2023-state-that-a-closed-circuit-allows-current-to-flow:6bac303209', text: 'State that a closed circuit allows current to flow.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Systems', source_citation: 'science-primary-2023.pdf p.61', order: 40};
MERGE (x:Theme {uid: 'theme:science-2023-interactions:25c1ebb5be'}) SET x += {uid: 'theme:science-2023-interactions:25c1ebb5be', name: 'Interactions', subject: 'Science', syllabus_version: '2023', kind: 'theme'};
MERGE (x:Topic {uid: 'topic:science-2023-interaction-of-forces-magnets-p3:db32d994a2'}) SET x += {uid: 'topic:science-2023-interaction-of-forces-magnets-p3:db32d994a2', name: 'Interaction of Forces (Magnets) (P3)', subject: 'Science', syllabus_version: '2023', primary_level: 'P3', track: null, core_ideas: ['Compare magnets, non-magnetic materials', 'and magnetic materials.', 'Make a magnet by the stroke method and', 'the electrical method.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-that-a-magnet-can-exert-a-push-or-a-pull:e3b5c08b0d'}) SET x += {uid: 'learningoutcome:science-2023-recognise-that-a-magnet-can-exert-a-push-or-a-pull:e3b5c08b0d', text: 'Recognise that a magnet can exert a push or a pull.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P3', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.63', order: 42, cognitive_level: 'knowledge', difficulty_band: 'foundational'};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-identify-the-characteristics-of-magnets-magnets-can-be-made-of-iron:eeb9b426e7'}) SET x += {uid: 'learningoutcome:science-2023-identify-the-characteristics-of-magnets-magnets-can-be-made-of-iron:eeb9b426e7', text: 'Identify the characteristics of magnets. - Magnets can be made of iron or steel. - Magnets have two poles. A freely suspended bar magnet comes to rest pointing in a North-South direction. - Unlike poles attract and like poles repel. - Magnets attract magnetic materials.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P3', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.63', order: 43, cognitive_level: 'knowledge', difficulty_band: 'core'};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-uses-of-magnets-in-everyday-objects:589ad363fd'}) SET x += {uid: 'learningoutcome:science-2023-recognise-uses-of-magnets-in-everyday-objects:589ad363fd', text: 'Recognise uses of magnets in everyday objects.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P3', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.64', order: 44};
MERGE (x:Topic {uid: 'topic:science-2023-interaction-of-forces-frictional-force-gravitational-force-elastic-:9e75a6e404'}) SET x += {uid: 'topic:science-2023-interaction-of-forces-frictional-force-gravitational-force-elastic-:9e75a6e404', name: 'Interaction of Forces (Frictional force, gravitational force, elastic spring force) (P6 Standard)', subject: 'Science', syllabus_version: '2023', primary_level: 'P6', track: 'Standard', core_ideas: ['Investigate the effect of frictional force on', 'the motion of objects.', 'Investigate the effects of elastic spring', 'force.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-identify-a-force-as-a-push-or-a-pull:12f7badfab'}) SET x += {uid: 'learningoutcome:science-2023-identify-a-force-as-a-push-or-a-pull:12f7badfab', text: 'Identify a force as a push or a pull.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.66', order: 49};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-show-an-understanding-of-the-effects-of-a-force-a-force-can-move-a-:5ff4e79127'}) SET x += {uid: 'learningoutcome:science-2023-show-an-understanding-of-the-effects-of-a-force-a-force-can-move-a-:5ff4e79127', text: 'Show an understanding of the effects of a force. - A force can move a stationary object. - A force can speed up, slow down or change the direction of motion. - A force can stop a moving object. - A force may change the shape of an object.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.64', order: 46};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-and-give-examples-of-the-different-types-of-forces-magnet:ca27ddb48c'}) SET x += {uid: 'learningoutcome:science-2023-recognise-and-give-examples-of-the-different-types-of-forces-magnet:ca27ddb48c', text: 'Recognise and give examples of the different types of forces. - Magnetic force - Gravitational force - Elastic spring force - Frictional force', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.65', order: 47, cognitive_level: 'application', difficulty_band: 'challenging'};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-that-objects-have-weight-because-of-the-gravitational-for:1426d84d33'}) SET x += {uid: 'learningoutcome:science-2023-recognise-that-objects-have-weight-because-of-the-gravitational-for:1426d84d33', text: 'Recognise that objects have weight because of the gravitational force acting on the object.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.68', order: 52};
MERGE (x:Topic {uid: 'topic:science-2023-interaction-of-forces-frictional-force-gravitational-force-p6-found:df53ddfa15'}) SET x += {uid: 'topic:science-2023-interaction-of-forces-frictional-force-gravitational-force-p6-found:df53ddfa15', name: 'Interaction of Forces (Frictional force, gravitational force) (P6 Foundation)', subject: 'Science', syllabus_version: '2023', primary_level: 'P6', track: 'Foundation', core_ideas: ['Investigate the effect of frictional force on', 'the motion of objects.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-state-the-effects-of-a-force-a-force-can-move-a-stationary-object-a:6fe285143b'}) SET x += {uid: 'learningoutcome:science-2023-state-the-effects-of-a-force-a-force-can-move-a-stationary-object-a:6fe285143b', text: 'State the effects of a force. - A force can move a stationary object. - A force can speed up, slow down or change the direction of motion. - A force can stop a moving object. A force may change the shape of an object.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.66', order: 50};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-and-give-examples-of-the-different-types-of-forces-magnet:02e531dfe6'}) SET x += {uid: 'learningoutcome:science-2023-recognise-and-give-examples-of-the-different-types-of-forces-magnet:02e531dfe6', text: 'Recognise and give examples of the different types of forces. - Magnetic force - Gravitational force - Frictional force', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.66', order: 51};
MERGE (x:Topic {uid: 'topic:science-2023-interactions-within-the-environment-p6-standard:7b217ca4b5'}) SET x += {uid: 'topic:science-2023-interactions-within-the-environment-p6-standard:7b217ca4b5', name: 'Interactions within the Environment (P6 Standard)', subject: 'Science', syllabus_version: '2023', primary_level: 'P6', track: 'Standard', core_ideas: ['Observe, collect and record information', 'regarding the interacting factors within an', 'environment.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-identify-the-factors-that-affect-the-survival-of-an-organism-physic:77210aa070'}) SET x += {uid: 'learningoutcome:science-2023-identify-the-factors-that-affect-the-survival-of-an-organism-physic:77210aa070', text: 'Identify the factors that affect the survival of an organism. - Physical characteristics of the environment (temperature, light, water) - Availability of food - Types of other organisms present (producers, consumers, decomposers)', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.72', order: 60};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-show-an-understanding-of-the-effect-on-organisms-when-the-environme:115661676d'}) SET x += {uid: 'learningoutcome:science-2023-show-an-understanding-of-the-effect-on-organisms-when-the-environme:115661676d', text: 'Show an understanding of the effect on organisms when the environment becomes unfavourable (organisms adapt and survive; move to other places or die).', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.68', order: 54};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-show-an-understanding-of-the-energy-pathway-from-the-sun-through-li:b56cab4fa2'}) SET x += {uid: 'learningoutcome:science-2023-show-an-understanding-of-the-energy-pathway-from-the-sun-through-li:b56cab4fa2', text: 'Show an understanding of the energy pathway from the Sun through living things and identify the roles of various organisms (producers, consumers, predators, prey) in a food chain and a food web.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.69', order: 55};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-differentiate-among-organism-population-and-community-an-organism-i:131234f8e1'}) SET x += {uid: 'learningoutcome:science-2023-differentiate-among-organism-population-and-community-an-organism-i:131234f8e1', text: 'Differentiate among organism, population and community. - An organism is a living thing. - A population is a group of organisms of the same kind, living and reproducing at a given place and time. - A community consists of many populations living together in a particular place.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.69', order: 56};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-show-an-understanding-that-different-habitats-support-different-com:2093d3d5fd'}) SET x += {uid: 'learningoutcome:science-2023-show-an-understanding-that-different-habitats-support-different-com:2093d3d5fd', text: 'Show an understanding that different habitats support different communities (garden, field, pond, seashore, tree, mangrove swamp).', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.70', order: 57};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-show-an-understanding-that-adaptations-serve-to-enhance-survival-an:b32fdb1eef'}) SET x += {uid: 'learningoutcome:science-2023-show-an-understanding-that-adaptations-serve-to-enhance-survival-an:b32fdb1eef', text: 'Show an understanding that adaptations serve to enhance survival and can be structural or behavioural. - Cope with physical factors - Obtain food - Escape predators - Reproduce by finding and attracting mates or dispersing seeds/fruits', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.70', order: 58};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-give-examples-of-man-s-impact-both-positive-and-negative-on-the-env:21cb21d2d1'}) SET x += {uid: 'learningoutcome:science-2023-give-examples-of-man-s-impact-both-positive-and-negative-on-the-env:21cb21d2d1', text: 'Give examples of man’s impact (both positive and negative) on the environment.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.74', order: 64};
MERGE (x:Topic {uid: 'topic:science-2023-interactions-within-the-environment-p6-foundation:c0e81e67f3'}) SET x += {uid: 'topic:science-2023-interactions-within-the-environment-p6-foundation:c0e81e67f3', name: 'Interactions within the Environment (P6 Foundation)', subject: 'Science', syllabus_version: '2023', primary_level: 'P6', track: 'Foundation', core_ideas: ['Observe, collect, and record information', 'regarding the interacting factors within an', 'environment.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-the-energy-pathway-from-the-sun-through-living-things-and:ba3cf421b4'}) SET x += {uid: 'learningoutcome:science-2023-recognise-the-energy-pathway-from-the-sun-through-living-things-and:ba3cf421b4', text: 'Recognise the energy pathway from the Sun through living things and identify the roles of various organisms (producers, consumers, predators, prey) in a food chain.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.72', order: 61};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-that-different-habitats-support-different-organisms-garde:79576a6a08'}) SET x += {uid: 'learningoutcome:science-2023-recognise-that-different-habitats-support-different-organisms-garde:79576a6a08', text: 'Recognise that different habitats support different organisms (garden, field, pond, seashore, tree, mangrove swamp).', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.73', order: 62};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-that-adaptations-serve-to-enhance-survival-and-can-be-str:b73dfc6900'}) SET x += {uid: 'learningoutcome:science-2023-recognise-that-adaptations-serve-to-enhance-survival-and-can-be-str:b73dfc6900', text: 'Recognise that adaptations serve to enhance survival and can be structural or behavioural. - Cope with physical factors - Obtain food - Escape predators - Reproduce by finding and attracting mates or dispersing seeds/fruits', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P6', theme: 'Interactions', source_citation: 'science-primary-2023.pdf p.73', order: 63};
MERGE (x:Theme {uid: 'theme:science-2023-energy:714ae86abb'}) SET x += {uid: 'theme:science-2023-energy:714ae86abb', name: 'Energy', subject: 'Science', syllabus_version: '2023', kind: 'theme'};
MERGE (x:Topic {uid: 'topic:science-2023-energy-forms-and-uses-light-p4:01b983f570'}) SET x += {uid: 'topic:science-2023-energy-forms-and-uses-light-p4:01b983f570', name: 'Energy Forms and Uses (Light) (P4)', subject: 'Science', syllabus_version: '2023', primary_level: 'P4', track: null, core_ideas: ['Investigate the variables that affect', 'shadows formed.', 'Shape, size and position of object(s)', 'Distance between light source-object', 'and object-screen', 'Note:', 'The use of specific terms (transparent,', 'translucent, opaque) is not required.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-that-an-object-can-be-seen-when-it-reflects-light-or-when:fc6adefb76'}) SET x += {uid: 'learningoutcome:science-2023-recognise-that-an-object-can-be-seen-when-it-reflects-light-or-when:fc6adefb76', text: 'Recognise that an object can be seen when it reflects light or when it is a source of light.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P4', theme: 'Energy', source_citation: 'science-primary-2023.pdf p.76', order: 65};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-that-light-travels-in-straight-lines-and-thus-a-shadow-is:0869ccc0a6'}) SET x += {uid: 'learningoutcome:science-2023-recognise-that-light-travels-in-straight-lines-and-thus-a-shadow-is:0869ccc0a6', text: 'Recognise that light travels in straight lines and thus a shadow is formed when light is completely or partially blocked by an object.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P4', theme: 'Energy', source_citation: 'science-primary-2023.pdf p.77', order: 66};
