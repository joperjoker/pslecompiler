MERGE (x:Topic {uid: 'topic:science-2023-diversity-of-living-and-non-living-things-general-characteristics-a:1dc6164b04'}) SET x += {uid: 'topic:science-2023-diversity-of-living-and-non-living-things-general-characteristics-a:1dc6164b04', name: 'Diversity of Living and Non-Living Things (General characteristics and classification) (P3)', subject: 'Science', syllabus_version: '2023', primary_level: 'P3', track: null, core_ideas: ['Observe a variety of living and non-living', 'things and infer differences between them.', 'Classify living things into broad groups (in', 'plants and animals) based on similarities', 'and differences of common observable', 'characteristics.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-describe-the-characteristics-of-living-things-need-water-food-and-a:2a16a2f109'}) SET x += {uid: 'learningoutcome:science-2023-describe-the-characteristics-of-living-things-need-water-food-and-a:2a16a2f109', text: 'Describe the characteristics of living things. - Need water, food and air to survive - Grow, respond and reproduce', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P3', theme: 'Diversity', source_citation: 'science-primary-2023.pdf p.39', order: 1};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-some-broad-groups-of-living-things-based-on-similarities-:72af89a3bf'}) SET x += {uid: 'learningoutcome:science-2023-recognise-some-broad-groups-of-living-things-based-on-similarities-:72af89a3bf', text: 'Recognise some broad groups of living things based on similarities and differences. - Plants (flowering, non-flowering) - Animals (amphibians, birds, fish, insects, mammals, reptiles) - Fungi (mould, mushroom, yeast) - Bacteria', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P3', theme: 'Diversity', source_citation: 'science-primary-2023.pdf p.39', order: 2};
MERGE (x:Topic {uid: 'topic:science-2023-diversity-of-materials-p3:067990baa2'}) SET x += {uid: 'topic:science-2023-diversity-of-materials-p3:067990baa2', name: 'Diversity of Materials (P3)', subject: 'Science', syllabus_version: '2023', primary_level: 'P3', track: null, core_ideas: ['Compare physical properties of materials.', 'Strength', 'Flexibility', 'Ability to float/sink in water', 'Waterproof', 'Transparency', 'Note:', 'The focus is on how the properties of materials', 'are used.', 'The “strength” of a material is its ability to be', 'subjected to loads without breaking.', 'The “flexibility” of a material is its ability to', 'bend without breaking.', 'The “ability to float on water” refers to whether', 'an object is able to stay on or near the surface', 'of water and not sink. (The concept of density', 'is not required.)', 'A material is “waterproof” when it does not', 'absorb water.', 'The “transparency” of a material refers to', 'whether the material allows most/ some or no', 'light to pass through. (The use of terms –', 'transparent/ translucent/ opaque is not', 'required.)']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-relate-the-use-of-various-types-of-materials-wood-metal-ceramic-rub:5bb80c1534'}) SET x += {uid: 'learningoutcome:science-2023-relate-the-use-of-various-types-of-materials-wood-metal-ceramic-rub:5bb80c1534', text: 'Relate the use of various types of materials (wood, metal, ceramic, rubber, glass, plastic, fabric) to their physical properties.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P3', theme: 'Diversity', source_citation: 'science-primary-2023.pdf p.42', order: 3};
MERGE (x:Theme {uid: 'theme:science-2023-cycles:c44cfc956e'}) SET x += {uid: 'theme:science-2023-cycles:c44cfc956e', name: 'Cycles', subject: 'Science', syllabus_version: '2023', kind: 'theme'};
MERGE (x:Topic {uid: 'topic:science-2023-cycles-in-plants-and-animals-life-cycles-p3:07b11a95ba'}) SET x += {uid: 'topic:science-2023-cycles-in-plants-and-animals-life-cycles-p3:07b11a95ba', name: 'Cycles in Plants and Animals (Life Cycles) (P3)', subject: 'Science', syllabus_version: '2023', primary_level: 'P3', track: null, core_ideas: ['Observe and compare the life cycles of', 'plants grown from seeds over a period of', 'time.', 'Note:', 'The focus is on the stages (seed, young', 'plant, adult plant) of flowering plants.', 'Processes in plant reproduction (pollination,', 'fertilisation, seed dispersal and germination)', 'are introduced in the topic of Cycles in', 'Plants and Animals (Reproduction) in P5.', 'animals over a period of time (chicken,', 'cockroach, frog, grasshopper, beetle,', 'butterfly, mosquito)']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-show-an-understanding-that-different-living-things-have-different-l:6e5b587d58'}) SET x += {uid: 'learningoutcome:science-2023-show-an-understanding-that-different-living-things-have-different-l:6e5b587d58', text: 'Show an understanding that different living things have different life cycles. - Plants - Animals', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P3', theme: 'Cycles', source_citation: 'science-primary-2023.pdf p.44', order: 4};
MERGE (x:Topic {uid: 'topic:science-2023-cycles-in-plants-and-animals-reproduction-p5-standard:dbbbc9d0fc'}) SET x += {uid: 'topic:science-2023-cycles-in-plants-and-animals-reproduction-p5-standard:dbbbc9d0fc', name: 'Cycles in Plants and Animals (Reproduction) (P5 Standard)', subject: 'Science', syllabus_version: '2023', primary_level: 'P5', track: 'Standard', core_ideas: ['Investigate the ways in which plants', 'reproduce.', 'Spores', 'Seeds', 'Note:', 'Vegetative propagation methods, such as', 'stem cutting, are not required.']};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-recognise-that-a-cell-is-a-basic-unit-of-life:8abc08c45d'}) SET x += {uid: 'learningoutcome:science-2023-recognise-that-a-cell-is-a-basic-unit-of-life:8abc08c45d', text: 'Recognise that a cell is a basic unit of life.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Cycles', source_citation: 'science-primary-2023.pdf p.44', order: 5};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-show-an-understanding-that-living-things-reproduce-to-ensure-contin:ae524bc5c8'}) SET x += {uid: 'learningoutcome:science-2023-show-an-understanding-that-living-things-reproduce-to-ensure-contin:ae524bc5c8', text: 'Show an understanding that living things reproduce to ensure continuity of their kind and that many characteristics of an organism are passed on from parents to offspring.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Cycles', source_citation: 'science-primary-2023.pdf p.44', order: 6};
MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-describe-processes-in-the-sexual-reproduction-of-flowering-plants-p:d2364641d4'}) SET x += {uid: 'learningoutcome:science-2023-describe-processes-in-the-sexual-reproduction-of-flowering-plants-p:d2364641d4', text: 'Describe processes in the sexual reproduction of flowering plants. - Pollination - Fertilisation (seed production) - Seed dispersal - Germination', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P5', theme: 'Cycles', source_citation: 'science-primary-2023.pdf p.44', order: 7};
