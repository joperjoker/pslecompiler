MERGE (x:LearningOutcome {uid: 'learningoutcome:science-2023-state-that-matter-is-anything-that-has-mass-and-occupies-space:4607f1e3bf'}) SET x += {uid: 'learningoutcome:science-2023-state-that-matter-is-anything-that-has-mass-and-occupies-space:4607f1e3bf', text: 'State that matter is anything that has mass and occupies space.', subject: 'Science', syllabus_version: '2023', effective_year: 2023, level: 'Standard', primary_level: 'P4', theme: 'Cycles', source_citation: 'science-primary-2023.pdf p.49', order: 12};
